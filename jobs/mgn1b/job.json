  {
   "do": "ic7100.af",
   "level": 0.2
  },
  {
   "do": "pluto",
   "args": [
    "send",
    "job:tone20.wav",
    "--hz",
    "445850000",
    "--dev",
    "3000",
    "--gain",
    "-46"
   ],
   "continue_on_error": true
  },
  {
   "do": "ic7100.af",
   "level": 0.3
  },
  {
   "do": "pluto",
   "args": [
    "send",
    "job:tone20.wav",
    "--hz",
    "445850000",
    "--dev",
    "3000",
