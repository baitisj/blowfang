{
 "id": "micp5c",
 "who": "micprobe",
 "freq_mhz": "bench",
 "minutes": 10,
 "steps": [
  {
   "do": "logger",
   "seconds": 400,
   "file": "k6.log"
  },
  {
   "do": "ic7100.tune",
   "hz": 440850000
  },
  {
   "do": "k6.upload",
   "module": "job:miclvl.bin",
   "args": [
    "--via",
    "pluto",
    "--pluto-gain",
    "-40",
    "--api-level",
    "4",
    "--rate",
    "auto",
    "--rate-state",
    "run:k6-rate.json",
    "--telemetry",
    "0",
    "--rounds",
    "1",
    "--run-s",
    "0"
   ],
   "continue_on_error": true,
   "sha256": "4d1fcb09430718c6482d78dca69d412fdc9d39eb6fecf8067e540253e9b6fc4f"
  },
  {
   "do": "pluto",
   "args": [
    "send",
    "job:tone700steps.wav",
    "--hz",
    "440850000",
    "--dev",
    "3000",
    "--gain",
    "-40"
   ],
   "continue_on_error": true
  },
  {
   "do": "wait",
   "pattern": "miclvl done",
   "seconds": 60,
   "continue_on_error": true
  },
  {
   "do": "wait",
   "seconds": 8
  },
  {
   "do": "logger.stop"
  }
 ]
}
