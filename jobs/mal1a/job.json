{
 "id": "mal1a",
 "who": "micprobe",
 "freq_mhz": "bench",
 "minutes": 60,
 "steps": [
  {
   "do": "logger",
   "seconds": 3600,
   "file": "k6.log"
  },
  {
   "do": "ic7100.tune",
   "hz": 440850000
  },
  {
   "do": "pluto",
   "args": [
    "send",
    "job:wake.wav",
    "--hz",
    "440850000",
    "--dev",
    "3000",
    "--gain",
    "-30"
   ],
   "continue_on_error": true
  },
  {
   "do": "k6.upload",
   "module": "job:micalias.bin",
   "args": [
    "--via",
    "pluto",
    "--pluto-gain",
    "-40",
    "--api-level",
    "13",
    "--rate",
    "auto",
    "--rate-state",
    "run:k6-rate.json",
    "--telemetry",
    "0",
    "--rounds",
    "1",
    "--run-s",
    "0"
   ],
   "continue_on_error": true,
   "sha256": "7b08e3e6767f74d79379fef5a2076c519b299f25aebd18d60af90876c33a5ad6"
  },
  {
   "do": "wait",
   "pattern": "micalias done",
   "seconds": 3000,
   "continue_on_error": true
  },
  {
   "do": "wait",
   "seconds": 5
  },
  {
   "do": "logger.stop"
  }
 ]
}
