{
 "id": "micr1b",
 "who": "micprobe",
 "freq_mhz": "bench",
 "minutes": 12,
 "steps": [
  {
   "do": "logger",
   "seconds": 480,
   "file": "k6.log"
  },
  {
   "do": "ic7100.tune",
   "hz": 440850000
  },
  {
   "do": "pluto",
   "args": [
    "send",
    "job:wake.wav",
    "--hz",
    "440850000",
    "--dev",
    "3000",
    "--gain",
    "-30"
   ],
   "continue_on_error": true
  },
  {
   "do": "k6.upload",
   "module": "job:micprobe.bin",
   "args": [
    "--via",
    "pluto",
    "--pluto-gain",
    "-40",
    "--api-level",
    "4",
    "--rate",
    "auto",
    "--rate-state",
    "run:k6-rate.json",
    "--telemetry",
    "0",
    "--rounds",
    "1",
    "--run-s",
    "30"
   ],
   "continue_on_error": true,
   "sha256": "3cb48543c311544ead63c355300b2babb25fad324f61ed0a1449f8d5948dc694"
  },
  {
   "do": "pluto",
   "args": [
    "send",
    "job:tone1300x60.wav",
    "--hz",
    "445850000",
    "--dev",
    "3000",
    "--gain",
    "-46"
   ],
   "continue_on_error": true
  },
  {
   "do": "wait",
   "pattern": "micprobe done",
   "seconds": 90,
   "continue_on_error": true
  },
  {
   "do": "wait",
   "seconds": 8
  },
  {
   "do": "logger.stop"
  }
 ]
}
