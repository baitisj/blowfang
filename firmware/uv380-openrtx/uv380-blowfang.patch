+ * key in PAGER mode). Safe to call from any thread; PAGER mode starts the
+ * playback on its next update, and does nothing in other modes.
+ */
+void pager_requestPreview(void);
+
+/**
+ * blowfang PAGER mode: what PTT sends. 1: FSK, the pager's PHY F (1800 baud
+ * FFSK, which the K6's VOICE MSG plays as it arrives); 0: RNG, PHY R (coded
+ * range packets). The plain build is always FSK; the range build starts in RNG
+ * at power-on and pager_togglePhy() (macro key 4) switches it.
+ */
+int pager_phyFsk(void);
+void pager_togglePhy(void);
+
+/**
+ * blowfang PAGER mode: the UI reports whether FUNC (the side button above PTT)
+ * is held. The range probe build records the mic while it is held and sends
+ * the recording when it is let go (Jeff 11-14).
+ */
+void pager_setFunc(int held);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PAGER_H */
