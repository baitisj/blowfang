@@ -0,0 +1,46 @@
+/*
+ * SPDX-FileCopyrightText: Copyright 2026 blowfang contributors
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#ifndef OPMODE_PAGER_H
+#define OPMODE_PAGER_H
+
+#include "core/audio_path.h"
+#include "OpMode.hpp"
+
+/**
+ * blowfang voice pager, transmit side: a press of PTT sends the stored sotto
+ * message as K6 voice-pager packets (FFSK 1200/1800 Hz, 1800 baud, XL), the
+ * format the Baofeng UV-K6 running blowfang receives, followed by the station
+ * ident in Morse. One press sends the whole message (about 15 s for 10 s of
+ * speech); pressing PTT again stops it. The radio does not receive in this mode.
+ *
+ * Transmission is refused outside 430-450 MHz.
+ */
+class OpMode_Pager : public OpMode
+{
+public:
+    OpMode_Pager();
+    ~OpMode_Pager();
+    virtual void enable() override;
+    virtual void disable() override;
+    virtual void update(rtxStatus_t *const status, const bool newCfg) override;
+    virtual opmode getID() override
+    {
+        return OPMODE_PAGER;
+    }
+    virtual bool rxSquelchOpen() override
+    {
+        return false;
+    }
+
+private:
+    void send(rtxStatus_t *const status);
+
+    bool   armed;        ///< PTT was released since the last send
+    uint8_t msgId;       ///< msg_id of the next message, new for each send
+};
+
+#endif /* OPMODE_PAGER_H */
