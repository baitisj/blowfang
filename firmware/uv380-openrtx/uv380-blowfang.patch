diff --git a/openrtx/src/rtx/OpMode_Pager.cpp b/openrtx/src/rtx/OpMode_Pager.cpp
new file mode 100644
index 00000000..81ad6678
--- /dev/null
+++ b/openrtx/src/rtx/OpMode_Pager.cpp
@@ -0,0 +1,1311 @@
+/*
+ * SPDX-FileCopyrightText: Copyright 2026 blowfang contributors
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "interfaces/platform.h"
+#include "interfaces/delays.h"
+#include "interfaces/audio.h"
+#include "interfaces/radio.h"
+#include "core/audio_stream.h"
+#include "core/state.h"
+#include "rtx/OpMode_Pager.hpp"
+#include "rtx/pager.h"
+#include "rtx/rtx.h"
+#include <pthread.h>
+#include <string.h>
+#include <math.h>
+#include <stdio.h>
+#ifdef PLATFORM_LINUX
+#include <stdlib.h>
+#endif
+
+extern "C" {
+#include "pager_tx.h"
+#include "ffsk_tx.h"
+#include "range_tx.h"
+#include "cw_tx.h"
+#include "sotto/sotto.h"
+}
+#include "blowfang_message.h"
+#include "blowfang_config.h"
+
+static constexpr uint32_t FS        = 48000;    // PWM sample rate into the modulator
+static constexpr uint32_t BAUD      = 1800;
+static constexpr size_t   BLOCK     = 960;      // samples per half buffer, 20 ms
+static constexpr int16_t  LEVEL     = 16000;    // FFSK peak (deviation: set on the bench)
+static constexpr int16_t  CW_LEVEL  = 13107;
+// Bench knobs over USB ("lvl", "fs", "emph": tuneCommand), so hamlet can set
+// the FFSK level, the rate the modulator is told the PWM runs at, and the
+// pre-emphasis on air with no reflash (11-14: the K6 read none of the
+// UV-380's first FSK sends). They last until power-off.
+static volatile int16_t  txLevel   = LEVEL;
+static volatile uint32_t txFs      = FS;
+// PHY F's tones ("mark N", "space N"; 0: ffsk_tx's 1200/1800 Hz). The UV-380's
+// audio path pulls them about 6 % together on air (11-14 15:2xZ), which the
+// K6's chip FSK may not take: these let hamlet pre-distort them, no reflash.
+static volatile uint32_t txMark    = 0;
+static volatile uint32_t txSpace   = 0;
+#if defined(PLATFORM_MDUV3x0)
+extern "C" volatile bool blowfang_txFlat;
+extern "C" volatile int32_t blowfang_txTrimHz;
+#else
+__attribute__((unused)) static volatile bool blowfang_txFlat = false;
+__attribute__((unused)) static volatile int32_t blowfang_txTrimHz = 0;
+#endif
+static constexpr freq_t   TX_MIN_HZ = 430000000;
+static constexpr freq_t   TX_MAX_HZ = 450000000;
+static constexpr unsigned SETTLE_MS = 60;       // silence after keying, before the lead-in
+
+#ifndef BLOWFANG_CALLSIGN
+#define BLOWFANG_CALLSIGN "AG7EW"
+#endif
+
+// Speaker preview: the stored message through the fixed-point sotto 1200
+// decoder (8 kHz) to the speaker, in a thread of its own (the rtx thread's
+// stack is too small for the decoder).
+static constexpr size_t   PV_BLOCK  = SOTTO_LR_SAMPLES_PER_FRAME;  // 40 ms at 8 kHz
+static constexpr size_t   PV_STACK  = 16384;
+
+// Audio stream buffers are read by DMA, so on the radio they go in .bss2 (the
+// 128 KB RAM): .bss is in the 64 KB CCM RAM (linker_script_MDx.ld), which no
+// DMA reaches. (The I2S probe's buffers in .bss failed this way on the first
+// flash, 2026-11-13; these were never run on the radio before that.)
+#if defined(PLATFORM_MDUV3x0)
+#define DMA_RAM __attribute__((section(".bss2")))
+#else
+#define DMA_RAM
+#endif
+DMA_RAM static stream_sample_t txBuf[2 * BLOCK];
+DMA_RAM static stream_sample_t pvBuf[2 * PV_BLOCK];
+static volatile bool   pvRequest = false;   // set by the UI (# key)
+static volatile bool   pvStop    = false;
+static volatile bool   pvRunning = false;
+static bool            pvJoinable = false;
+static pthread_t       pvThread;
+static pt_air  air;
+#ifdef BLOWFANG_RANGE
+static rg_air  rair;    // the range build: PHY R (docs/k6-range.md) in place of the pager's PHY F
+static volatile bool phyF = false;  // "phy f": the pager's PHY F instead, until power-off
+#endif
+static ffsk_tx ffsk;
+static cw_tx   cw;
+static char    ident[12];
+
+// The message PTT sends and # plays: the stored one (blowfang_message.h), or
+// the last recording a RAM module made with the radio's sotto 1200 encoder
+// (ortx_mod.h level 2), kept until the next one or a power-off. .bss: CCM on
+// the radio, which is fine (no DMA reads it).
+static constexpr unsigned REC_MAX   = 750;      // superframes: 30 s
+static constexpr long long SEND_MAX_MS = 120000;
+static uint8_t         recMsg[REC_MAX * PT_FRAME_BYTES];
+static unsigned        recFrames  = 0;
+static volatile bool   recValid   = false;
+static volatile bool   msgChanged = false;  // update() makes a new msg_id
+static bool            sendIdentOnly = false;   // send(): the Morse ident alone
+#if defined(BLOWFANG_I2SPROBE) && !defined(PLATFORM_LINUX)
+static constexpr freq_t SEND_HZ   = 440850000;  // tx_request sends only here
+static volatile bool   txRequest  = false;  // a module asked for a send
+static volatile unsigned micTxMs  = 0;      // a module asked for the keyed mic test
+static volatile unsigned toneTxMs = 0;      // a module asked for the keyed line-in tone
+static volatile unsigned toneHz   = 0;
+static bool            fnArmed    = false;  // FUNC let go since PAGER mode began
+#endif
+static volatile bool   fnHeld     = false;  // FUNC held (the UI, pager_setFunc)
+#if defined(PLATFORM_MDUV3x0)
+// radio_UV3x0.cpp (blowfang): 1 W whatever the channel says, and the mic in
+// place of the line in
+extern "C" volatile bool blowfang_txLow;
+extern "C" volatile bool blowfang_txMic;
+#else
+__attribute__((unused)) static volatile bool blowfang_txLow = false;
+__attribute__((unused)) static volatile bool blowfang_txMic = false;
+#endif
+
+static const uint8_t *msgBytes()
+{
+    return recValid ? recMsg : blowfang_message;
+}
+
+static unsigned msgFrames()
+{
+    return recValid ? recFrames : BLOWFANG_MESSAGE_FRAMES;
+}
+
+void pager_requestPreview()
+{
+    pvRequest = true;
+}
+
+int pager_phyFsk()
+{
+#ifdef BLOWFANG_RANGE
+    return phyF ? 1 : 0;
+#else
+    return 1;
+#endif
+}
+
+void pager_setFunc(int held)
+{
+    fnHeld = (held != 0);
+}
+
+void pager_togglePhy()
+{
+#ifdef BLOWFANG_RANGE
+    phyF = !phyF;
+#endif
+}
+
+/* The next 320 samples of the stored message into out, false once the
+ * decoder has given all of it (its last superframes come from the flush). */
+static bool pvNext(struct sotto_lr_dec *dec, unsigned &frame, stream_sample_t *out)
+{
+    if(frame < msgFrames())
+    {
+        sotto_lr_decode(dec, msgBytes() + frame * PT_FRAME_BYTES, 1, out);
+        frame++;
+        return true;
+    }
+    return sotto_lr_dec_flush(dec, out) != 0;
+}
+
+static void *previewFunc(void *arg)
+{
+    (void) arg;
+    struct sotto_lr_dec *dec = sotto_lr_dec_create();
+    unsigned frame = 0;
+    if(dec == NULL)
+    {
+        pvRunning = false;
+        return NULL;
+    }
+
+#ifdef PLATFORM_LINUX
+    // Emulator: the samples go to a file (BLOWFANG_PREVIEW_OUT, default
+    // /tmp/blowfang_preview.raw: signed 16-bit, 8 kHz) for
+    // tests/test_uv380_openrtx_emu.py to check against sotto's own decoder.
+    const char *out = getenv("BLOWFANG_PREVIEW_OUT");
+    if(out == NULL)
+        out = "/tmp/blowfang_preview.raw";
+    FILE *f = fopen(out, "wb");
+    if(f != NULL)
+    {
+        while((pvStop == false) && pvNext(dec, frame, pvBuf))
+            fwrite(pvBuf, sizeof(stream_sample_t), PV_BLOCK, f);
+        fclose(f);
+        printf("blowfang: preview written to %s\n", out);
+        fflush(stdout);
+    }
+#else
+    pathId path = audioPath_request(SOURCE_MCU, SINK_SPK, PRIO_PROMPT);
+    if(path >= 0)
+    {
+        memset(pvBuf, 0, sizeof(pvBuf));
+        streamId stream = audioStream_start(path, pvBuf, 2 * PV_BLOCK, 8000,
+                                            STREAM_OUTPUT | BUF_CIRC_DOUBLE);
+        if(stream >= 0)
+        {
+            // As OpenRTX's codec2 decoder: sync first, so that the decoder
+            // never writes the half the stream is reading.
+            outputStream_sync(stream, false);
+            while((pvStop == false) && (audioPath_getStatus(path) == PATH_OPEN))
+            {
+                stream_sample_t *idle = outputStream_getIdleBuffer(stream);
+                if(idle == NULL)
+                    break;
+                bool more = pvNext(dec, frame, idle);
+                if(more == false)
+                    memset(idle, 0, PV_BLOCK * sizeof(stream_sample_t));
+                outputStream_sync(stream, true);
+                if(more == false)
+                    break;
+            }
+            audioStream_stop(stream);
+        }
+        audioPath_release(path);
+    }
+#endif
+
+    sotto_lr_dec_destroy(dec);
+    pvRunning = false;
+    return NULL;
+}
+
+/* Waits for the preview thread to end, asking it to stop first if stop. */
+static void joinPreview(bool stop)
+{
+    if(pvJoinable == false)
+        return;
+    if(stop)
+        pvStop = true;
+    pthread_join(pvThread, NULL);
+    pvJoinable = false;
+}
+
+static void startPreview()
+{
+    joinPreview(false);         // only a finished one can be left here
+    pvStop    = false;
+    pvRunning = true;
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, PV_STACK);
+    if(pthread_create(&pvThread, &attr, previewFunc, NULL) == 0)
+        pvJoinable = true;
+    else
+        pvRunning = false;
+    pthread_attr_destroy(&attr);
+}
+
+
+#ifdef BLOWFANG_I2SPROBE
+// blowfang I2S probe build (BLOWFANG_I2SPROBE=1 sh build.sh): while PAGER mode
+// is idle the radio receives, and a thread of its own runs i2sprobe.c's pass
+// every few seconds, its lines to USB serial. It stands aside for PTT and the
+// speaker preview: update() holds it and waits for the step running to end.
+extern "C" {
+#include "i2sprobe.h"
+#include "ortx_mod.h"
+#ifndef PLATFORM_LINUX
+#include "drivers/usb_vcom.h"
+#endif
+}
+extern "C" {
+#include "pager_rec.h"
+#include "pager_listen.h"
+}
+#if defined(PLATFORM_MDUV3x0)
+#include "hwconfig.h"
+#include "peripherals/gpio.h"
+#endif
+
+// 6 KB: a RAM module (ortx_mod.h) runs on this stack too
+static constexpr size_t   PB_STACK = 6144;
+static constexpr unsigned PB_PAUSE_MS = 5000;   // between passes
+static volatile bool pbRun  = false;
+static volatile bool pbHold = false;
+static volatile bool pbBusy = false;
+static bool          pbJoinable = false;
+static pthread_t     pbThread;
+// DMA buffer: .bss is in the 64 KB CCM RAM on this radio (linker_script_MDx.ld),
+// which no DMA can reach, so it goes in .bss2 (the 128 KB RAM). In .bss, the ADC
+// stream never filled it and inputStream_getData() waited forever (first flash,
+// 2026-11-13).
+DMA_RAM static stream_sample_t pbAdcBuf[2048];
+
+static void pbSay(void *ctx, const char *s)
+{
+    (void) ctx;
+#ifdef PLATFORM_LINUX
+    printf("%s\n", s);
+    fflush(stdout);
+#else
+    vcom_writeBlock(s, strlen(s));
+    vcom_writeBlock("\r\n", 2);
+#endif
+}
+
+static void pbWrite(void *ctx, uint8_t reg, uint8_t val)
+{
+    (void) ctx;
+#if defined(PLATFORM_MDUV3x0)
+    C6000.writeCfgRegister(reg, val);
+#else
+    (void) reg;
+    (void) val;
+#endif
+}
+
+static uint8_t pbRead(void *ctx, uint8_t reg)
+{
+    (void) ctx;
+#if defined(PLATFORM_MDUV3x0)
+    return C6000.readCfgRegister(reg);
+#else
+    (void) reg;
+    return 0;
+#endif
+}
+
+static void pbSleep(void *ctx, unsigned ms)
+{
+    (void) ctx;
+    sleepFor(0, ms);
+}
+
+static int pbStop(void *ctx)
+{
+    (void) ctx;
+    return (pbRun == false) || pbHold || pvRunning || platform_getPttStatus();
+}
+
+// PC3 (AIN_RTX) through OpenRTX's own input stream: both halves of a double
+// buffer, in order
+static unsigned pbAdc(void *ctx, int16_t *buf, unsigned n, unsigned fs)
+{
+    (void) ctx;
+#ifdef PLATFORM_LINUX
+    (void) buf;
+    (void) n;
+    (void) fs;
+    return 0;
+#else
+    unsigned got = 0;
+    if(n > 2048)
+        n = 2048;
+    pathId path = audioPath_request(SOURCE_RTX, SINK_MCU, PRIO_RX);
+    if(path < 0)
+        return 0;
+    streamId id = audioStream_start(path, pbAdcBuf, n, fs,
+                                    STREAM_INPUT | BUF_CIRC_DOUBLE);
+    if(id >= 0)
+    {
+        for(int half = 0; half < 2; half++)
+        {
+            dataBlock_t d = inputStream_getData(id);
+            if(d.data == NULL)
+                break;
+            memcpy(buf + got, d.data, d.len * sizeof(stream_sample_t));
+            got += d.len;
+        }
+        audioStream_stop(id);
+    }
+    audioPath_release(path);
+    return got;
+#endif
+}
+
+static const i2sp_ops pbOps = {pbSay, pbWrite, pbRead, pbSleep, pbStop, pbAdc,
+                               NULL};
+
+// RAM modules (ortx_mod.h): "mod ..." lines load signed code over USB serial
+// and run it on this thread, so hamlet can try new code with no reflash.
+#ifndef PLATFORM_LINUX
+static void omWrite(const void *b, unsigned n)
+{
+    vcom_writeBlock(b, n);
+}
+
+static unsigned omRead(void *b, unsigned n)
+{
+    ssize_t r = vcom_readBlock(b, n);
+    return (r > 0) ? (unsigned) r : 0;
+}
+
+static void omLine(const char *s)
+{
+    pbSay(NULL, s);
+}
+
+static uint32_t omNow()
+{
+    return (uint32_t) getTick();
+}
+
+static int omStop()
+{
+    return pbStop(NULL);
+}
+
+static void omSleep(uint32_t ms)
+{
+    sleepFor(0, ms);
+}
+
+static uint8_t omC6r(uint8_t reg)
+{
+    return pbRead(NULL, reg);
+}
+
+static void omC6w(uint8_t reg, uint8_t val)
+{
+    pbWrite(NULL, reg, val);
+}
+
+static unsigned omAdc(int16_t *buf, unsigned n, unsigned fs)
+{
+    return pbAdc(NULL, buf, n, fs);
+}
+
+static int32_t omRssi()
+{
+    return (int32_t) rtx_getRssi();   // the RTX thread's last reading
+}
+
+// "lvl N" (FFSK peak, 1000-32000; default 16000), "fs N" (the rate the
+// modulator is told the PWM runs at, 47000-49000; default 48000: corrects the
+// tones and the baud rate together), "emph 0|1" (pre-emphasis off or on;
+// default on), "trim N" (Hz added to the transmit frequency, -8000 to 8000;
+// default 3580, this radio's measured error). Each answers with all four;
+// "tune" alone only answers.
+static int tuneCommand(const char *line)
+{
+    unsigned long v = 0;
+    const char *p = NULL;
+    if(strncmp(line, "lvl ", 4) == 0)
+        p = line + 4;
+    else if(strncmp(line, "fs ", 3) == 0)
+        p = line + 3;
+    else if(strncmp(line, "emph ", 5) == 0)
+        p = line + 5;
+    else if(strncmp(line, "trim ", 5) == 0)
+        p = line + 5;
+    else if(strncmp(line, "mark ", 5) == 0)
+        p = line + 5;
+    else if(strncmp(line, "space ", 6) == 0)
+        p = line + 6;
+    else if(strcmp(line, "tune") != 0)
+        return 0;
+    bool num = false;
+    bool neg = (p != NULL) && (*p == '-');
+    if(neg)
+        p++;
+    for(; (p != NULL) && (*p >= '0') && (*p <= '9') && (v < 100000); p++)
+    {
+        v = v * 10 + (unsigned long) (*p - '0');
+        num = true;
+    }
+    if(num && !neg && (line[0] == 'l') && (v >= 1000) && (v <= 32000))
+        txLevel = (int16_t) v;
+    else if(num && !neg && (line[0] == 'f') && (v >= 47000) && (v <= 49000))
+        txFs = (uint32_t) v;
+    else if(num && (line[0] == 'e') && (v <= 1) && (neg == false))
+        blowfang_txFlat = (v == 0);
+    else if(num && (line[0] == 't') && (v <= 8000))
+        blowfang_txTrimHz = neg ? -(int32_t) v : (int32_t) v;
+    else if(num && !neg && (line[0] == 'm') && ((v == 0) || ((v >= 800) && (v <= 2600))))
+        txMark = (uint32_t) v;
+    else if(num && !neg && (line[0] == 's') && ((v == 0) || ((v >= 800) && (v <= 2600))))
+        txSpace = (uint32_t) v;
+    char out[96];
+    snprintf(out, sizeof(out), "tune lvl=%d fs=%lu emph=%d trim=%ld mark=%lu space=%lu",
+             (int) txLevel, (unsigned long) txFs, blowfang_txFlat ? 0 : 1,
+             (long) blowfang_txTrimHz, (unsigned long) txMark, (unsigned long) txSpace);
+    pbSay(NULL, out);
+    return 1;
+}
+
+// "phy fsk" / "phy rng" (USB or a module's probe line; the first letter is
+// enough): what PTT and tx_request send in the range build, FSK, the pager's
+// PHY F (FFSK 1200/1800 Hz at 1800 baud, which the K6's VOICE MSG plays as it
+// arrives), or RNG, PHY R (the default); macro key 4 switches it too
+static int phyCommand(const char *line)
+{
+#ifdef BLOWFANG_RANGE
+    if(strncmp(line, "phy ", 4) != 0)
+        return 0;
+    if(line[4] == 'f')
+        phyF = true;
+    else if(line[4] == 'r')
+        phyF = false;
+    pbSay(NULL, phyF ? "phy FSK" : "phy RNG");
+    return 1;
+#else
+    (void) line;
+    return 0;
+#endif
+}
+
+// a probe command line from a module ("cap ...", "c6w ...")
+static int omProbe(const char *line)
+{
+    if(phyCommand(line) || tuneCommand(line))
+        return 0;
+    return (i2sp_command(&pbOps, line) < 0) ? -1 : 0;
+}
+
+// Level 2: the fixed-point sotto 1200 encoder (8 kHz). It runs in a thread of
+// its own, whose stack it needs (its deepest calls take about 8 KB, more than
+// the module's); enc_push hands it 320 samples at a time in two buffers and
+// waits while it is still on the other one.
+static constexpr size_t ENC_STACK = 16384;
+static struct sotto_lr_enc *enc = NULL;
+static int16_t        encIn[2][SOTTO_LR_SAMPLES_PER_FRAME];
+static unsigned       encCur  = 0;
+static unsigned       encFill = 0;
+static volatile int   encReady = -1;    // the buffer handed over, -1: none
+static volatile bool  encQuit  = false;
+static pthread_t      encThread;
+
+static void encAppend(const uint8_t *f)
+{
+    if(recFrames < REC_MAX)
+    {
+        memcpy(recMsg + recFrames * PT_FRAME_BYTES, f, PT_FRAME_BYTES);
+        recFrames++;
+    }
+}
+
+static void *encFunc(void *arg)
+{
+    (void) arg;
+    uint8_t out[SOTTO_BYTES_PER_FRAME];
+    for(;;)
+    {
+        int b = encReady;
+        if(b >= 0)
+        {
+            if(sotto_lr_encode(enc, encIn[b], out))
+                encAppend(out);
+            encReady = -1;
+            continue;
+        }
+        if(encQuit)
+            break;
+        sleepFor(0, 1);
+    }
+    // the last part (whole 10 ms blocks of it), then the flush
+    if(encFill >= 80)
+        sotto_lr_encode_part(enc, encIn[encCur], (int) (encFill / 80));
+    while(sotto_lr_enc_flush(enc, out))
+        encAppend(out);
+    return NULL;
+}
+
+static int omEncEnd()
+{
+    if(enc == NULL)
+        return -1;
+    for(unsigned t = 0; (encReady >= 0) && (t < 2000); t++)
+        sleepFor(0, 1);
+    encQuit = true;
+    pthread_join(encThread, NULL);
+    sotto_lr_enc_destroy(enc);
+    enc        = NULL;
+    recValid   = (recFrames > 0);
+    msgChanged = true;
+    return (int) recFrames;
+}
+
+static int omEncBegin()
+{
+    if(enc != NULL)
+        omEncEnd();
+    recValid   = false;
+    msgChanged = true;
+    recFrames  = 0;
+    encCur     = 0;
+    encFill    = 0;
+    encReady   = -1;
+    encQuit    = false;
+    enc = sotto_lr_enc_create();
+    if(enc == NULL)
+        return -1;
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, ENC_STACK);
+    int r = pthread_create(&encThread, &attr, encFunc, NULL);
+    pthread_attr_destroy(&attr);
+    if(r != 0)
+    {
+        sotto_lr_enc_destroy(enc);
+        enc = NULL;
+        return -1;
+    }
+    return 0;
+}
+
+static int omEncPush(const int16_t *x, unsigned n)
+{
+    if(enc == NULL)
+        return -1;
+    for(unsigned i = 0; i < n; i++)
+    {
+        if(recFrames >= REC_MAX)
+            return -1;
+        encIn[encCur][encFill++] = x[i];
+        if(encFill < SOTTO_LR_SAMPLES_PER_FRAME)
+            continue;
+        for(unsigned t = 0; (encReady >= 0) && (t < 2000); t++)
+            sleepFor(0, 1);
+        if(encReady >= 0)
+            return -1;          // the encoder thread is stuck
+        encReady = (int) encCur;
+        encCur  ^= 1;
+        encFill  = 0;
+    }
+    return (int) recFrames;
+}
+
+static unsigned omMsg(const uint8_t **bytes)
+{
+    *bytes = msgBytes();
+    return msgFrames();
+}
+
+static void omPreview()
+{
+    pager_requestPreview();
+}
+
+// The keyed mic test (tx_mic): ms of FM carrying the microphone, as FM mode
+// sends it (MIC_PWR on, the C6000's mic input), at 1 W, then the Morse ident.
+// A module captures I2S3 meanwhile, to see whether the mic reaches the MCU
+// while keyed.
+static int omTxMic(unsigned ms)
+{
+    rtxStatus_t st = rtx_getCurrentStatus();
+    if((ms == 0) || (ms > 5000) || (st.txFrequency != SEND_HZ) || (st.txDisable != 0))
+        return -1;
+    micTxMs = ms;
+    return 0;
+}
+
+static void micTest(rtxStatus_t *const status, unsigned ms)
+{
+    pathId path = audioPath_request(SOURCE_MIC, SINK_RTX, PRIO_TX);
+    if(path < 0)
+        return;
+    blowfang_txMic = true;
+    status->opStatus = TX;
+    platform_ledOn(RED);
+    radio_enableTx();
+    for(unsigned t = 0; (t < ms) && (platform_getPttStatus() == false); t += 10)
+        sleepFor(0, 10);
+    radio_disableRtx();
+    blowfang_txMic = false;
+    audioPath_release(path);
+    platform_ledOff(RED);
+}
+
+// The keyed line-in tone (tx_tone, level 3): ms of FM carrying a tone from the
+// MCU through the line in (the path every send takes), at 1 W, then the Morse
+// ident. The module runs on meanwhile and may switch the C6000's transmit
+// source (E0) and capture I2S3: can the radio send modem audio and hear the
+// mic at once (Jeff 11-14: stream sotto while PTT is held)?
+static int omTxTone(unsigned ms, unsigned hz)
+{
+    rtxStatus_t st = rtx_getCurrentStatus();
+    if((ms == 0) || (ms > 5000) || (hz < 100) || (hz > 3000) ||
+       (st.txFrequency != SEND_HZ) || (st.txDisable != 0))
+        return -1;
+    toneHz   = hz;
+    toneTxMs = ms;
+    return 0;
+}
+
+static void toneTest(rtxStatus_t *const status, unsigned ms, unsigned hz)
+{
+    pathId path = audioPath_request(SOURCE_MCU, SINK_RTX, PRIO_TX);
+    if(path < 0)
+        return;
+    status->opStatus = TX;
+    platform_ledOn(RED);
+    radio_enableTx();
+    memset(txBuf, 0, sizeof(txBuf));
+    streamId stream = audioStream_start(path, txBuf, 2 * BLOCK, FS,
+                                        STREAM_OUTPUT | BUF_CIRC_DOUBLE);
+    if(stream >= 0)
+    {
+        // y[n] = 2 cos(w) y[n-1] - y[n-2], restarted each block from the
+        // phase so it doesn't drift in amplitude
+        const float w = 6.2831853f * (float) hz / (float) FS;
+        float phase = 0.0f;
+        unsigned blocks = (ms * (FS / 1000) + BLOCK - 1) / BLOCK;
+        stream_sample_t *idle = outputStream_getIdleBuffer(stream);
+        for(unsigned b = 0; (b < blocks) && (platform_getPttStatus() == false); b++)
+        {
+            float c2 = 2.0f * cosf(w), y1 = sinf(phase - w), y2 = sinf(phase - 2.0f * w);
+            for(size_t i = 0; i < BLOCK; i++)
+            {
+                float y = c2 * y1 - y2;
+                y2 = y1;
+                y1 = y;
+                idle[i] = (stream_sample_t) (y * (float) txLevel);
+            }
+            phase += w * (float) BLOCK;
+            while(phase > 6.2831853f)
+                phase -= 6.2831853f;
+            outputStream_sync(stream, true);
+            idle = outputStream_getIdleBuffer(stream);
+        }
+        audioStream_stop(stream);
+    }
+    radio_disableRtx();
+    audioPath_release(path);
+    platform_ledOff(RED);
+}
+
+// The mic preamp (MIC_PWR, PA13) stays on in PAGER mode: it settles over
+// about 6 s after switch-on (11-14 micrec_adc), so a recording that switched
+// it on as it keyed came out silent (11-14 08:46Z). Releasing a mic audio path
+// switches it off: on again after each.
+static void micPreamp(bool on)
+{
+#if defined(PLATFORM_MDUV3x0)
+    if(on)
+        gpio_setPin(MIC_PWR);
+    else
+        gpio_clearPin(MIC_PWR);
+#else
+    (void) on;
+#endif
+}
+
+// FUNC, the black side button above PTT (Jeff 11-14): hold it to record, let
+// go to send. The mic reaches the MCU only while the radio transmits with the
+// mic selected (11-14 08:56Z), so the radio sends FM voice while FUNC is held,
+// LED orange, and the C6000's codec input (I2S3, pager_rec) feeds the sotto
+// 1200 encoder meanwhile, at micsend's gain (16, 11-14 09:05Z: byte-exact on
+// air). When the 30 s store fills, the carrier drops and the LED blinks red
+// until FUNC is let go. Returns the frames recorded, or -1 if nothing keyed.
+static constexpr unsigned REC_GAIN   = 16;
+static constexpr unsigned REC_SKIP   = 150;    // ms of key-up thump not recorded
+static constexpr unsigned REC_HOLDMS = 10000;  // blink at most this long when full
+static int16_t recX[64];
+
+static int recordMic(rtxStatus_t *const status)
+{
+    static const pr_host host = {omC6r, omC6w, omSleep};
+    if(omEncBegin() != 0)
+        return -1;
+    pathId path = audioPath_request(SOURCE_MIC, SINK_RTX, PRIO_TX);
+    if(path < 0)
+    {
+        omEncEnd();
+        return -1;
+    }
+    pager_rec_start(&host, pbAdcBuf, sizeof(pbAdcBuf) / sizeof(pbAdcBuf[0]));
+    blowfang_txMic = true;
+    status->opStatus = TX;
+    platform_ledOn(GREEN);
+    platform_ledOn(RED);        // green and red: orange
+    radio_enableTx();
+    bool full = false;
+    long long t0 = getTick();
+    while(fnHeld && (platform_getPttStatus() == false))
+    {
+        unsigned g = pager_rec_take(recX, 64);
+        if(g == 0)
+        {
+            sleepFor(0, 2);
+            continue;
+        }
+        if(getTick() - t0 < REC_SKIP)
+            continue;
+        for(unsigned i = 0; i < g; i++)
+        {
+            int32_t v = (int32_t) recX[i] * (int32_t) REC_GAIN;
+            recX[i] = (int16_t) (v > 32767 ? 32767 : (v < -32767 ? -32767 : v));
+        }
+        if(omEncPush(recX, g) < 0)
+        {
+            full = true;
+            break;
+        }
+    }
+    radio_disableRtx();
+    blowfang_txMic = false;
+    pager_rec_stop();
+    audioPath_release(path);
+    micPreamp(true);
+    platform_ledOff(GREEN);
+    int frames = omEncEnd();
+    if(full)
+    {
+        long long t1 = getTick();
+        while(fnHeld && (getTick() - t1 < REC_HOLDMS))
+        {
+            if(((getTick() - t1) / 250) & 1)
+                platform_ledOff(RED);
+            else
+                platform_ledOn(RED);
+            sleepFor(0, 20);
+        }
+    }
+    platform_ledOff(RED);
+    return frames;
+}
+
+static int omTxRequest()
+{
+    rtxStatus_t st = rtx_getCurrentStatus();
+    if((st.txFrequency != SEND_HZ) || (st.txDisable != 0))
+        return -1;
+    txRequest = true;
+    return 0;
+}
+
+static const om_host omHost = {omLine, omWrite, omRead, omNow, omStop,
+                               omSleep, omC6r, omC6w, omAdc, omRssi,
+                               omProbe, omEncBegin, omEncPush, omEncEnd,
+                               omMsg, omPreview, omTxRequest, omTxMic,
+                               omTxTone};
+#endif
+
+// The receiver (pager_listen.h, Jeff 11-14: "get the synthesizer ported to
+// the HT"): while PAGER mode sits idle in receive, PHY R packets heard on the
+// air are put back together into a message, which then becomes the message
+// (as a recording does: # plays it again, PTT sends it) and plays on the
+// speaker at once. It keeps pbBusy while it runs, so holdProbe() (PTT, FUNC,
+// #) stops it within a poll; it stops for every USB command and module too.
+#ifndef PLATFORM_LINUX
+static constexpr uint32_t OTG_DSTS = 0x50000808u;  // bit 0: USB suspended (no cable)
+static bool lsOn   = false;
+static bool lsFail = false;    // no heap for it: not tried again until PAGER mode restarts
+static char lsLine[64];
+
+static void lsSay(const char *s)
+{
+    // a write with no host waits 500 ms: none with the cable out (11-14)
+    if(((*(volatile uint32_t *) OTG_DSTS) & 1u) == 0)
+        pbSay(NULL, s);
+}
+
+static void listenOff()
+{
+    if(lsOn == false)
+        return;
+    pager_listen_stop();
+    lsOn   = false;
+    pbBusy = false;
+}
+
+static void listenStep()
+{
+    static const pr_host host = {omC6r, omC6w, omSleep};
+    bool want = (pbStop(NULL) == false) && (fnHeld == false) && (txRequest == false) &&
+                (micTxMs == 0) && (toneTxMs == 0) && (lsFail == false);
+    if(want == false)
+    {
+        listenOff();
+        return;
+    }
+    if(lsOn == false)
+    {
+        pbBusy = true;
+        if(pbStop(NULL))
+        {
+            pbBusy = false;
+            return;
+        }
+        if(pager_listen_start(&host, pbAdcBuf, sizeof(pbAdcBuf) / sizeof(pbAdcBuf[0]),
+                              REC_MAX) != 0)
+        {
+            pbBusy = false;
+            lsFail = true;
+            lsSay("heard err no memory");
+            return;
+        }
+        lsOn = true;
+    }
+    int r = pager_listen_poll((uint32_t) getTick(), lsLine, sizeof(lsLine));
+    if(r == PL_NONE)
+        return;
+    lsSay(lsLine);
+    if(r != PL_READY)
+        return;
+    recValid  = false;
+    recFrames = pager_listen_take(recMsg, REC_MAX);
+    recValid  = (recFrames > 0);
+    msgChanged = true;
+    listenOff();
+    if(recValid)
+        pager_requestPreview();
+}
+#else
+static bool lsOn   = false;
+static bool lsFail = false;
+static void listenOff() { }
+static void listenStep() { }
+#endif
+
+// Command lines from USB serial (i2sprobe.h, i2sp_command), read between
+// passes, so hamlet can drive the probe with no reflash: "auto 0" stops the
+// passes, "help" lists the rest, "mod ..." goes to the module loader.
+static bool     pbAuto = false;    // auto passes starve the UI (11-14): "auto 1" to start
+static char     pbCmd[OM_LINE];
+static unsigned pbCmdLen = 0;
+
+static void pbPoll(const i2sp_ops *ops)
+{
+#ifdef PLATFORM_LINUX
+    (void) ops;
+#else
+    char c;
+    while(vcom_readBlock(&c, 1) == 1)
+    {
+        if((c != '\r') && (c != '\n'))
+        {
+            if(pbCmdLen < sizeof(pbCmd) - 1)
+                pbCmd[pbCmdLen++] = c;
+            continue;
+        }
+        if(pbCmdLen == 0)
+            continue;
+        pbCmd[pbCmdLen] = '\0';
+        pbCmdLen = 0;
+        listenOff();
+        if(pbStop(NULL))
+        {
+            pbSay(NULL, "err busy (PTT or the speaker preview)");
+            continue;
+        }
+        pbBusy = true;
+        int r = 0;
+        if((strncmp(pbCmd, "mod", 3) == 0) &&
+           ((pbCmd[3] == ' ') || (pbCmd[3] == '\0')))
+        {
+            om_command(&omHost, pbCmd + 3);
+            if(enc != NULL)     // a module that ended mid-recording: keep what it made
+                omEncEnd();
+        }
+        else if((phyCommand(pbCmd) == 0) && (tuneCommand(pbCmd) == 0))
+            r = i2sp_command(ops, pbCmd);
+        pbBusy = false;
+        if(r == I2SP_AUTO_ON)
+            pbAuto = true;
+        else if(r == I2SP_AUTO_OFF)
+            pbAuto = false;
+    }
+#endif
+}
+
+static void *probeFunc(void *arg)
+{
+    (void) arg;
+    const i2sp_ops &ops = pbOps;
+    while(pbRun)
+    {
+        if(pbAuto && (pbStop(NULL) == false))
+        {
+            listenOff();
+            pbBusy = true;
+            if(pbStop(NULL) == false)
+                i2sp_pass(&ops);
+            pbBusy = false;
+        }
+        for(unsigned t = 0; (t < PB_PAUSE_MS) && pbRun; )
+        {
+            pbPoll(&ops);
+            listenStep();
+            unsigned ms = lsOn ? 10 : 50;   // the ring holds 128 ms
+            sleepFor(0, ms);
+            t += ms;
+        }
+    }
+    listenOff();
+    return NULL;
+}
+
+static void startProbe()
+{
+    if(pbJoinable)
+        return;
+    pbRun  = true;
+    pbHold = false;
+    lsFail = false;
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, PB_STACK);
+    if(pthread_create(&pbThread, &attr, probeFunc, NULL) == 0)
+        pbJoinable = true;
+    else
+        pbRun = false;
+    pthread_attr_destroy(&attr);
+}
+
+static void stopProbe()
+{
+    if(pbJoinable == false)
+        return;
+    pbRun = false;
+    pthread_join(pbThread, NULL);
+    pbJoinable = false;
+}
+
+// Holds the probe and waits (at most 3 s) for the step it is in to end
+static void holdProbe()
+{
+    pbHold = true;
+    for(unsigned t = 0; pbBusy && (t < 3000); t += 10)
+        sleepFor(0, 10);
+}
+#else
+static void startProbe() { }
+static void stopProbe() { }
+static void holdProbe() { }
+#endif
+
+OpMode_Pager::OpMode_Pager() : armed(false), msgId(0) { }
+
+OpMode_Pager::~OpMode_Pager() { }
+
+void OpMode_Pager::enable()
+{
+    armed = false;      // a PTT held while switching modes doesn't send
+    pvRequest = false;
+    msgId = pt_msg_id(msgBytes(), msgFrames());
+#if defined(BLOWFANG_I2SPROBE) && !defined(PLATFORM_LINUX)
+    fnArmed = false;    // nor does a FUNC held then
+    micPreamp(true);
+#endif
+    startProbe();
+}
+
+void OpMode_Pager::disable()
+{
+    stopProbe();
+    joinPreview(true);
+    platform_ledOff(GREEN);
+    platform_ledOff(RED);
+    radio_disableRtx();
+#if defined(BLOWFANG_I2SPROBE) && !defined(PLATFORM_LINUX)
+    micPreamp(false);
+#endif
+}
+
+void OpMode_Pager::update(rtxStatus_t *const status, const bool newCfg)
+{
+    (void) newCfg;
+
+    bool ptt = platform_getPttStatus();
+    if(ptt == false)
+        armed = true;
+
+    // # key: play the stored message on the speaker (again from the start
+    // if it is already playing)
+    if(pvRequest)
+    {
+        pvRequest = false;
+        holdProbe();
+        joinPreview(true);
+        startPreview();
+    }
+    if((pvRunning == false) && pvJoinable)
+        joinPreview(false);
+
+    if(msgChanged)
+    {
+        msgChanged = false;
+        msgId = pt_msg_id(msgBytes(), msgFrames());
+    }
+
+#if defined(BLOWFANG_I2SPROBE) && !defined(PLATFORM_LINUX)
+    // a module's tx_request (ortx_mod.h): the message as a PTT press sends it,
+    // once the module has ended, only on SEND_HZ
+    if(txRequest && (pbBusy == false))
+    {
+        txRequest = false;
+        if((ptt == false) && (status->txDisable == 0) &&
+           (status->txFrequency == SEND_HZ))
+        {
+            holdProbe();
+            joinPreview(true);
+            blowfang_txLow = true;
+            send(status);
+            blowfang_txLow = false;
+        }
+    }
+    // tx_mic: keyed while the module runs on (it captures meanwhile), then
+    // the ident
+    if(micTxMs != 0)
+    {
+        unsigned ms = micTxMs;
+        micTxMs = 0;
+        if((ptt == false) && (status->txDisable == 0) &&
+           (status->txFrequency == SEND_HZ))
+        {
+            joinPreview(true);
+            blowfang_txLow = true;
+            micTest(status, ms);
+            micPreamp(true);
+            sendIdentOnly = true;
+            send(status);
+            sendIdentOnly = false;
+            blowfang_txLow = false;
+        }
+    }
+    // tx_tone: the same, with a tone from the MCU through the line in
+    if(toneTxMs != 0)
+    {
+        unsigned ms = toneTxMs;
+        toneTxMs = 0;
+        if((ptt == false) && (status->txDisable == 0) &&
+           (status->txFrequency == SEND_HZ))
+        {
+            joinPreview(true);
+            blowfang_txLow = true;
+            toneTest(status, ms, toneHz);
+            sendIdentOnly = true;
+            send(status);
+            sendIdentOnly = false;
+            blowfang_txLow = false;
+        }
+    }
+    // FUNC held: record the mic until it is let go, then send what was
+    // recorded as PTT does (RNG or FSK), at the channel's power, only on
+    // SEND_HZ; a tap too short to record a frame sends the ident alone
+    if(fnHeld == false)
+        fnArmed = true;
+    else if(fnArmed && (ptt == false) && (status->txDisable == 0) &&
+            (status->txFrequency == SEND_HZ))
+    {
+        fnArmed = false;
+        armed   = false;    // a PTT that cut the recording short doesn't send twice
+        holdProbe();
+        joinPreview(true);
+        int frames = recordMic(status);
+        if(frames >= 0)
+        {
+            sendIdentOnly = (frames == 0);
+            send(status);
+            sendIdentOnly = false;
+        }
+    }
+#endif
+
+    if(ptt && armed && (status->txDisable == 0))
+    {
+        armed = false;
+        holdProbe();            // the probe never runs during TX
+        joinPreview(true);      // the speaker preview never runs during TX
+        if((status->txFrequency >= TX_MIN_HZ) && (status->txFrequency <= TX_MAX_HZ))
+        {
+#if defined(BLOWFANG_I2SPROBE) && !defined(PLATFORM_LINUX)
+            blowfang_txLow = true;  // the bench image: 1 W, as every send it makes (11-14:
+#endif                              // pulling the USB cable presses PTT)
+            send(status);
+#if defined(BLOWFANG_I2SPROBE) && !defined(PLATFORM_LINUX)
+            blowfang_txLow = false;
+#endif
+        }
+    }
+
+#ifdef BLOWFANG_I2SPROBE
+    // the probe build receives while idle (the probe listens to what comes
+    // in), and lets the probe run again once PTT and the preview are done
+    if(newCfg || (status->opStatus != RX))
+    {
+        radio_enableRx();
+        status->opStatus = RX;
+    }
+    if((ptt == false) && (pvRunning == false))
+        pbHold = false;
+#else
+    status->opStatus = OFF;
+#endif
+    platform_ledOff(RED);
+    sleepFor(0, 30);
+}
+
+/* Fills one block: FFSK, then the Morse ident, then silence. Returns false
+ * once both are done and the block is all silence. */
+static bool fill(stream_sample_t *buf, size_t n, bool &inCw)
+{
+    size_t got = 0;
+    if(inCw == false)
+    {
+        got = ffsk_render(&ffsk, buf, n);
+        if(got < n)
+            inCw = true;
+    }
+    if(inCw)
+        got += cw_render(&cw, buf + got, n - got);
+    if(got < n)
+        memset(buf + got, 0, (n - got) * sizeof(stream_sample_t));
+    return got > 0;
+}
+
+void OpMode_Pager::send(rtxStatus_t *const status)
+{
+    static const pt_profile prof = PT_PROFILE_XL(PT_MAGIC_1200);
+    pt_message msg = {&prof, msgBytes(), msgFrames(), 1, msgId};
+    msgId++;            // a new msg_id for each message sent
+
+    const char *call = state.settings.callsign;
+    if((call[0] == '\0') || (strcmp(call, "N0CALL") == 0))
+        call = BLOWFANG_CALLSIGN;
+    strncpy(ident, call, sizeof(ident) - 1);
+    ident[sizeof(ident) - 1] = '\0';
+
+#ifdef BLOWFANG_RANGE
+    // The range build (BLOWFANG_RANGE=1 sh build.sh): the same XL packets as
+    // PHY R, coded FFSK at 600/1200 Hz and 1200 baud for the K6's sensitive
+    // receiver (c/k6/mod/rangerx.c), through the same pre-emphasised voice path;
+    // or, after "phy f", the pager's PHY F as the plain build sends it.
+    if(phyF == false)
+    {
+        rg_air_defaults(&rair, pt_message_source, &msg);
+        ffsk_init_src(&ffsk, rg_air_next, &rair, txFs, RG_BAUD, RG_MARK_HZ, RG_SPACE_HZ,
+                      txLevel);
+    }
+    else
+#endif
+    {
+        pt_air_defaults(&air, prof.payload, BAUD, pt_message_source, &msg);
+        ffsk_init(&ffsk, &air, txFs, BAUD, txMark, txSpace, txLevel);
+    }
+    cw_init(&cw, ident, txFs, 20, 800, CW_LEVEL);
+
+#ifdef PLATFORM_LINUX
+    // Emulator: no modulator to drive, so the samples go to a file
+    // (BLOWFANG_PAGER_OUT, default /tmp/blowfang_pager.raw: signed 16-bit,
+    // 48 kHz) for tests/test_uv380_openrtx_emu.py to decode.
+    const char *out = getenv("BLOWFANG_PAGER_OUT");
+    if(out == NULL)
+        out = "/tmp/blowfang_pager.raw";
+    FILE *f = fopen(out, "wb");
+    if(f == NULL)
+        return;
+    status->opStatus = TX;
+    radio_enableTx();
+    bool inCw = sendIdentOnly;
+    while(fill(txBuf, BLOCK, inCw))
+        fwrite(txBuf, sizeof(stream_sample_t), BLOCK, f);
+    fclose(f);
+    radio_disableRtx();
+    printf("blowfang: pager message sent to %s\n", out);
+    fflush(stdout);
+#else
+
+    pathId path = audioPath_request(SOURCE_MCU, SINK_RTX, PRIO_TX);
+    if(path < 0)
+        return;
+
+    status->opStatus = TX;
+    platform_ledOn(RED);
+    radio_enableTx();
+    sleepFor(0, SETTLE_MS);
+
+    memset(txBuf, 0, sizeof(txBuf));
+    streamId stream = audioStream_start(path, txBuf, 2 * BLOCK, FS,
+                                        STREAM_OUTPUT | BUF_CIRC_DOUBLE);
+    if(stream >= 0)
+    {
+        bool inCw     = sendIdentOnly;
+        bool released = false;
+        long long t0  = getTick();
+        stream_sample_t *idle = outputStream_getIdleBuffer(stream);
+        while(audioPath_getStatus(path) == PATH_OPEN)
+        {
+            // never longer than SEND_MAX_MS, whatever happens (the longest
+            // message, 30 s as PHY R, takes about 75 s with its ident)
+            if(getTick() - t0 > SEND_MAX_MS)
+                break;
+            // One press sends the whole message; a second press cuts it
+            // short, but the Morse ident still goes out (every
+            // transmission carries it: on air 11-14 a cut send had none)
+            bool ptt = platform_getPttStatus();
+            if(ptt == false)
+                released = true;
+            else if(released && (inCw == false))
+                inCw = true;
+
+            bool more = fill(idle, BLOCK, inCw);
+            outputStream_sync(stream, true);
+            idle = outputStream_getIdleBuffer(stream);
+            if(more == false)
+                break;
+        }
+        audioStream_stop(stream);
+    }
+
+    radio_disableRtx();
+    audioPath_release(path);
+    platform_ledOff(RED);
+#endif
+}
