+
+/// At rest: a wrap's update flag counted and cleared (the interrupt does it when armed).
+/// Interrupts off.
+#[cfg(not(feature = "lean"))]
+#[inline(never)]
+fn count_wrap() {
+    if rd(TIM14_SR) & 1 != 0 {
+        wr(TIM14_SR, 0);
+        WRAPS.store(WRAPS.load(Ordering::Relaxed).wrapping_add(1), Ordering::Relaxed);
+    }
