+#[cfg(feature = "lean")]
+fn rx_led(_on: bool) {}
+#[cfg(feature = "lean")]
+fn rx_blink(_now: u16) {}
+#[cfg(feature = "lean")]
+fn rx_led_poll(_now: u16) {}
