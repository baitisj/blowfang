+pub fn keyed() {}
+#[cfg(feature = "lean")]
+pub fn keyed_for(_ms: u32) {}
+#[cfg(feature = "lean")]
+pub fn limit(_ms: u32) {}
+#[cfg(feature = "lean")]
+pub fn unkeyed() {}
+#[cfg(feature = "lean")]
+pub fn poll() {}
+#[cfg(feature = "lean")]
+pub fn ticks() -> Option<(u32, u32)> {
+    None
+}
