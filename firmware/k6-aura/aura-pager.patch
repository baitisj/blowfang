+
+fn rssi_dbm(app: &mut App, syst: &mut SYST) -> i16 {
+    let v = app.radio.fd6818.reg_read(syst, 0x67);
+    (((v & 0x1FF) >> 1) as i16) - 174 - unsafe { DMR_ADJ }
+}
+
+fn st() -> &'static mut State {
+    unsafe { &mut *addr_of_mut!(S) }
+}
+
+pub fn on() -> bool {
+    unsafe { (*addr_of!(S)).on }
+}
