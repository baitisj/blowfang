backup-only.patch: turns jaymart1983/Radtel-RT950-Pro-Firmware at 965eae2 (the commit pinned in
.github/workflows/rt950.yml) into the dump-only image for the RT-950 Pro backup (docs/rt950-backup.md).
  spi.c      no Write Enable is ever sent; erase and page program return at once
  cps.c      CPS writes are answered NAK; identity RT950-BACKUPONLY; CPS 0x800000+ reads MCU flash
  radio.c    PTT does nothing
  bk4829.c   REG_30's TX value is gone: TX mode becomes standby
  display.c  BACKUP ONLY in place of the RX/TX indicator and icons
Apply with patch -p1 in that tree (make -C radios/rt950 backup-image JM=DIR does it and checks the result).
SPDX-License-Identifier: GPL-3.0-or-later

diff --git a/src/app/cps.c b/src/app/cps.c
index 23c1f81..cd82720 100644
--- a/src/app/cps.c
+++ b/src/app/cps.c
@@ -107,9 +107,30 @@ static const uint8_t xor_key_table[20][4] = {
  * anything that does read it gets something meaningful.
  */
 static const uint8_t cps_identity[16] = {
-    'R','T','-','9','5','0','P','R','O',
-    'V','0','.','1', 0, 0, 0
-};
+    'R','T','9','5','0','-','B','A','C','K','U','P','O','N','L','Y'
+};  /* BACKUP ONLY: rt950_backup.py --addr 3 refuses any other identity */
+
+/*
+ * BACKUP ONLY: CPS addresses from 0x800000 read the MCU's own flash, so the
+ * 12 KB bootloader at 0x08000000 can be saved down the same cable. The SPI
+ * flash is 4 MB (0x000000-0x3FFFFF); the AT32F403A's flash is 1 MB.
+ */
+#define BK_MCU_WINDOW   0x800000UL
+#define BK_MCU_BASE     0x08000000UL
+#define BK_MCU_SIZE     0x100000UL
+
+static void backup_read(uint32_t addr, uint8_t *buf, uint8_t len)
+{
+    if (addr >= BK_MCU_WINDOW && addr + len <= BK_MCU_WINDOW + BK_MCU_SIZE) {
+        const volatile uint8_t *m = (const volatile uint8_t *)(BK_MCU_BASE + (addr - BK_MCU_WINDOW));
+        for (uint8_t i = 0; i < len; i++)
+            buf[i] = m[i];
+    } else if (addr + len <= 0x400000UL) {
+        spi_flash_read(addr, buf, len);
+    } else {
+        memset(buf, 0xFF, len);
+    }
+}
 
 /*
  * Session inactivity timeout.
@@ -363,7 +384,7 @@ int cps_poll(void)
                 out[2] = rx_buf[2];
                 out[3] = rx_buf[3];
                 out[4] = len;
-                spi_flash_read(addr, &out[5], len);
+                backup_read(addr, &out[5], len);
                 cps_xor(&out[5], len);          /* host decrypts with the key */
                 uart_send_buf(cps_port, out, (uint16_t)(5u + len));
 
@@ -373,46 +394,17 @@ int cps_poll(void)
             }
 
             if (op == CPS_CMD_WRITE) {
+                /* BACKUP ONLY: a write is consumed and refused (NAK 0x15),
+                 * and nothing reaches the flash. */
                 if (rx_pos < 5u)
                     break;
                 uint8_t len = rx_buf[4];
                 if (len > CPS_PACKET_SIZE)
                     len = CPS_PACKET_SIZE;
                 if (rx_pos < (uint16_t)(5u + len))
-                    break;                      /* payload still arriving */
-
-                uint32_t addr = ((uint32_t)rx_buf[1] << 16) |
-                                ((uint32_t)rx_buf[2] << 8) | rx_buf[3];
-
-                /*
-                 * Erase the sector the first time a write lands in it.
-                 *
-                 * Flash writes can only clear bits, so writing over existing
-                 * data ANDs with it rather than replacing it. That is exactly
-                 * what happened with the boot splash: the write reported
-                 * success, the data was silently combined with the image
-                 * already there, and the radio still showed the old picture.
-                 *
-                 * The host never sends an erase -- there is no such command --
-                 * so the radio has to do it. Tracking the last sector erased
-                 * means a sequential write erases each sector once, on entry,
-                 * rather than repeatedly or not at all.
-                 */
-                static uint32_t last_erased = 0xFFFFFFFFu;
-                uint32_t sector = addr & ~0xFFFu;
-                if (sector != last_erased) {
-                    spi_flash_erase_4k(sector);
-                    last_erased = sector;
-                }
-
-                uint8_t plain[CPS_PACKET_SIZE];
-                memcpy(plain, &rx_buf[5], len);
-                cps_xor(plain, len);
-                spi_flash_write_page(addr, plain, len);
-
-                uint8_t ack = 0x06u;
-                uart_send_buf(cps_port, &ack, 1);
-
+                    break;
+                uint8_t nak = 0x15u;
+                uart_send_buf(cps_port, &nak, 1);
                 memmove(rx_buf, &rx_buf[5 + len], rx_pos - (5u + len));
                 rx_pos -= (uint16_t)(5u + len);
                 continue;
